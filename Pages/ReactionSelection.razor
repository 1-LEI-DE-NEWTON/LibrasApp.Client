@page "/reaction-selection"

@using LibrasApp.Shared.Models
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="summary-container">
    <h1 class="intro-section">                
            Aqui você aprenderá sobre reações ácido-base de forma acessível, com explicações, imagens e Libras            
            <p class="intro-desc">
                Siga as etapas abaixo para explorar os conceitos e realizar os experimentos
            </p>
    </h1>

    <nav class="summary-nav">
        <h3>Sumário</h3>
        <ol>
            <li style="font-weight:bold;">Introdução: o que é uma Reação Ácido-Base?</li>
            <ul class="sub-list">
                <li>O que é um ácido?</li>
                <li>O que é uma base?</li>
                <li>O que é o pH?</li>
                <li>O que é uma reação ácido-base?</li>
            </ul>
        </ol>
    </nav>

    <section class="reaction-selection-section">        
        <button class="start-btn" @onclick="NavigateToIntroduction">Inicie sua Jornada</button>
    </section>
</div>

@code {
    private void NavigateToIntroduction()
    {
        NavigationManager.NavigateTo("/introduction");
    }
}

