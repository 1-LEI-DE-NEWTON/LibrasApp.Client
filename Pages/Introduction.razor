@page "/introduction"

<div class="introduction-container">
    <h2>Introdução</h2>
    <div class="intro-text">
        <h3>@introParts.ElementAtOrDefault(currentPart)?.Title</h3>
        @if (introParts.ElementAtOrDefault(currentPart)?.Paragraphs != null)
        {
            foreach (var p in introParts[currentPart].Paragraphs!)
            {
                <p>@p</p>
            }
        }
        @if (introParts.ElementAtOrDefault(currentPart)?.List != null)
        {
            <ul>
                @foreach (var item in introParts[currentPart].List!)
                {
                    <li>@item</li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(introParts.ElementAtOrDefault(currentPart)?.ImageUrl))
        {
            <img src="@introParts[currentPart].ImageUrl" alt="Imagem explicativa" class="intro-img" />
        }
    </div>
    <div class="intro-controls">
        <button class="back-btn" @onclick="() => PreviousPart()">Voltar</button>
        <button class="next-btn" @onclick="() => NextPart()">@(currentPart == introParts.Count - 1 ? "Instrumentos Necessários" : "Próximo")</button>
    </div>
</div>

@code {
    private int currentPart = 0;
    
    public class IntroPart
    {
        public string? Title { get; set; }
        public List<string>? Paragraphs { get; set; }
        public List<string>? List { get; set; }
        public string? ImageUrl { get; set; }
    }

    private List<IntroPart> introParts = new();
    
    protected override async Task OnInitializedAsync()
    {
        var json = await Http.GetStringAsync("data/introduction.json");
        introParts = System.Text.Json.JsonSerializer.Deserialize<List<IntroPart>>(json) ?? new List<IntroPart>();
    }

    private void NextPart()
    {
        if (currentPart < introParts.Count - 1)
        {
            currentPart++;
        }
        else if (currentPart == introParts.Count - 1)
        {
            NavigationManager.NavigateTo("/reaction-instruments/Reação%20Ácido-Base%201");
        }
    }
    private void PreviousPart()
    {
        if (currentPart > 0)
        {
            currentPart--;
        }
        else if (currentPart == 0)
        {
            NavigationManager.NavigateTo("/reaction-selection");
        }
    }
}

@inject NavigationManager NavigationManager
@inject HttpClient Http

<style>
.introduction-container {
    max-width: 800px;
    margin: 3rem auto;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
    padding: 2.5rem 2rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
}
.introduction-container h2 {
    font-size: 2rem;
    color: #1976d2;
    margin-bottom: 1.5rem;
    font-weight: bold;
}
.intro-text {
    font-size: 1.15rem;
    color: #222;
    margin-bottom: 2.2rem;
    min-height: 120px;
}
.intro-text h3 {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 0.8rem;
}
.intro-img {
    display: block;
    max-width: 100%;
    width: 320px;
    height: auto;
    margin: 1.5rem auto 0 auto;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(25, 118, 210, 0.08);
}
.intro-controls {
    display: flex;
    justify-content: space-between;
}
.back-btn {
    background: #c9e0f2;
    color: #222;
    border: none;
    border-radius: 18px;
    padding: 0.7rem 2.2rem;
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
}
.back-btn:hover {
    background: #b0cbe0;
}
.next-btn {
    background: #3b82f6;
    color: #fff;
    border: none;
    border-radius: 18px;
    padding: 0.7rem 2.2rem;
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
}
.next-btn:hover {
    background: #2563eb;
}
</style>
